# Server Port
PORT=5000

# MongoDB Connection String
# For local MongoDB: mongodb://127.0.0.1:27017/vishwas_db
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/vishwas_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/vishwas_db

# Environment
NODE_ENV=development
